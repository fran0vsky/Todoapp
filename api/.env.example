# Copy to api/.env and fill in (never commit api/.env).
# Dashboard: Supabase → Project Settings → API

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Browser client: Dashboard → API → anon / public key (used by GET /api/auth for the Angular app).
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# MUST be the long JWT under "service_role" → Reveal (NOT "anon", NOT "publishable").
# If you use the wrong key, /api/users returns: "This endpoint requires a valid Bearer token"
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Email allowed to DELETE projects (default admin@admin.com). Must match todo/src/app/admin.config.ts if you change it.
# Create this user in Supabase → Authentication → Users (Add user) e.g. admin@admin.com / Admin123!
# Optional nickname "ADMIN" via the app account panel after first login.
ADMIN_EMAIL=admin@admin.com

# Voice task: OpenRouter (https://openrouter.ai/keys) — speech-to-text + Claude on the server.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: model for speech-to-text via OpenRouter chat + input_audio (must support audio in).
# OPENROUTER_TRANSCRIPTION_MODEL=openai/gpt-4o-mini

# Recommended for Chrome WebM recordings: OpenAI Whisper (https://platform.openai.com/api-keys).
# Used automatically if OpenRouter chat transcription fails.
# OPENAI_API_KEY=sk-...

# Optional: append voice training rows (JSONL) to this file. If unset, POST /api/voice/log is a no-op.
# VOICE_DATA_LOG_PATH=api/logs/voice-data.jsonl

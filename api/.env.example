# Copy to api/.env and fill in (never commit api/.env).
# Dashboard: Supabase → Project Settings → API

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# MUST be the long JWT under "service_role" → Reveal (NOT "anon", NOT "publishable").
# If you use the wrong key, /api/users returns: "This endpoint requires a valid Bearer token"
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

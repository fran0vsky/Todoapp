# Copy to todo-e2e/.env or add these keys to the repo root .env (both are loaded by playwright.config.ts).
# Use a real Supabase Auth user for the same project as the Angular app and API.
# auth.setup.ts logs in once and writes todo-e2e/.auth/user.json (gitignored).
#
# Full suite (Chromium only — configured in todo-e2e/playwright.config.ts):
#   npx nx run todo-e2e:e2e
# Public-only tests (no credentials):
#   npx nx run todo-e2e:e2e -- --project=chromium-public
E2E_EMAIL=
E2E_PASSWORD=
